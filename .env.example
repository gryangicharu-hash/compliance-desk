# Copy to .env (never commit it) and fill in every value. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"           (secret key, blind index key)
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"   (encryption key)
# Keep a copy of FIELD_ENCRYPTION_KEYS and BLIND_INDEX_KEY in the SACCO's safe or password
# manager: without them, encrypted ID numbers in backups cannot be read.

DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=compliance.example-sacco.co.ke
DJANGO_CSRF_TRUSTED_ORIGINS=https://compliance.example-sacco.co.ke
FIELD_ENCRYPTION_KEYS=
BLIND_INDEX_KEY=

POSTGRES_PASSWORD=
PGPASSWORD=

INSTITUTION_NAME=Example Teachers Sacco Society Ltd
RISK_SETTINGS_VERSION=default-not-yet-approved
USD_KES_RATE=129.00
UN_LIST_URL=https://scsanctions.un.org/resources/xml/en/consolidated.xml

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example-sacco.co.ke
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=compliance-desk@example-sacco.co.ke

WEB_WORKERS=3
FORWARDED_ALLOW_IPS=*
IMPORT_INBOX_HOST=./inbox
BACKUP_DIR_HOST=./backups
